# Modèle (sans secret réel) : cp infra/env.example infra/.env (non versionné) pour surcharger les mots de
# passe de dev de docker-compose.yml. Ils ne servent qu'à la création des volumes : après un
# changement, docker compose -f infra/docker-compose.yml down -v (efface les données locales).
POSTGRES_PASSWORD=postgres-dev
ECOLE_OWNER_PASSWORD=owner-dev
ECOLE_APP_PASSWORD=app-dev
KEYCLOAK_DB_PASSWORD=keycloak-dev
KEYCLOAK_ADMIN_PASSWORD=admin-dev
RABBITMQ_PASSWORD=rabbit-dev
REDIS_PASSWORD=redis-dev
MINIO_PASSWORD=minio-dev-123
