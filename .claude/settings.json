{
  "permissions": {
    "allow": [
      "Bash(./mvnw *)",
      "Bash(npx nx *)",
      "Bash(npm run *)",
      "Bash(docker compose -f infra/docker-compose.yml up *)",
      "Bash(docker compose -f infra/docker-compose.yml ps *)",
      "Bash(docker compose -f infra/docker-compose.yml logs *)",
      "Bash(docker compose -f infra/docker-compose.yml down)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.envrc)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.dev*)",
      "Read(./**/.env.prod*)",
      "Read(./**/.env.preprod*)",
      "Read(./**/.env.stag*)",
      "Read(./**/.env.test*)",
      "Read(./**/.env.qa*)",
      "Read(./**/.env.ci*)",
      "Read(./**/.env.recette*)",
      "Read(./**/.env.secret*)",
      "Read(./**/.env.bak*)",
      "Read(./secrets/**)",
      "Bash(git push --force *)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/proteger-fichiers.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/formater.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "jdtls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": false,
    "github@claude-plugins-official": false
  }
}
